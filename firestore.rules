rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the shop's own logins, which Rajan creates in the Firebase console (sign-ups are blocked).
    function shopLogin() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.matches('[a-z0-9._-]+@chhabra-store[.]firebaseapp[.]com');
    }
    // Only the counter login writes: it uploads the shop phone's real data.
    function counter() {
      return shopLogin() && request.auth.token.email == 'counter@chhabra-store.firebaseapp.com';
    }
    // The stock phone (and the counter) record stock moves. A move is never changed afterwards:
    // a mistake is put right with a new move.
    function stockWriter() {
      return shopLogin() && request.auth.token.email in ['stock@chhabra-store.firebaseapp.com', 'counter@chhabra-store.firebaseapp.com'];
    }
    match /shops/chhabra/moves/{id} {
      allow read: if shopLogin();
      allow create: if stockWriter() && request.resource.data.by is string && request.resource.data.item is string;
    }
    // Suppliers: the stock phone (and the counter) keep the supplier list, the supplier khata and bill photos.
    // Khata lines and photos are never changed afterwards; a mistake is undone with a new line.
    match /shops/chhabra/vendors/{id} {
      allow read: if shopLogin();
      allow create, update: if stockWriter() && request.resource.data.name is string;
    }
    match /shops/chhabra/vledger/{id} {
      allow read: if shopLogin();
      allow create: if stockWriter() && request.resource.data.vendor is string && request.resource.data.amount is number;
    }
    match /shops/chhabra/photos/{id} {
      allow read: if shopLogin();
      allow create: if stockWriter() && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
    }
    // Accounts: any shop login records an expense (never changed afterwards) and the owner's notes.
    match /shops/chhabra/expenses/{id} {
      allow read: if shopLogin();
      allow create: if shopLogin() && request.resource.data.amount is number && request.resource.data.cat is string;
    }
    match /shops/chhabra/owner/{id} {
      allow read, write: if shopLogin();
    }
    match /shops/chhabra/{document=**} {
      allow read: if shopLogin();
      allow write: if counter();
    }
  }
}
